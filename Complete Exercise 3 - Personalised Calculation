#include <stdio.h>

int main(void)
{
    double speed = 40.0;
    double time = 3.0;
    double distance;

    /* Calculate distance by multiplying speed by time */
    distance = speed * time;

    printf("Distance: %.2f\n", distance);

    return 0;
}
